{
    "version": 3,
    "configurePresets": [
        {
            "name": "SingleBoard",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H7_BOARD": "SingleBoard"
            }
        },
        {
            "name": "GimbalBoard",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H7_BOARD": "GimbalBoard"
            }
        },
        {
            "name": "ChassisBoard",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H7_BOARD": "ChassisBoard"
            }
        },
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {"name": "SingleBoard", "configurePreset": "SingleBoard"},
        {"name": "GimbalBoard", "configurePreset": "GimbalBoard"},
        {"name": "ChassisBoard", "configurePreset": "ChassisBoard"},
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
